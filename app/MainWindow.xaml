<Window x:Class="DwnoEvoHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DwnoEvoHelper"
        Title="DWNO Evo-Helfer" Width="440" Height="760" MinWidth="360" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <!-- Digimon-Bild (Spielgrafik, 4px Radius), Platzhalter = Anfangsbuchstabe; Größe über Tag -->
        <DataTemplate x:Key="PicTemplate">
            <Grid Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}">
                <Border Background="{StaticResource PanelHi}" CornerRadius="4"/>
                <Image Source="{Binding Image}" Visibility="{Binding ImageVisibility}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" Foreground="{StaticResource Muted}"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Bedingung als Pill: erfüllt = Grün-Paar, offen = neutral, zu viel = Rot-Paar -->
        <DataTemplate x:Key="ChipTemplate">
            <Border CornerRadius="4" Padding="6,2,7,3" Margin="0,0,4,4" Background="{Binding Background}" ToolTip="{Binding Tooltip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}" Visibility="{Binding IconVisibility}" Foreground="{Binding Foreground}" FontWeight="SemiBold" Margin="0,0,4,0" FontSize="12"/>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="12" FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Karte für ein Digitationsziel -->
        <DataTemplate x:Key="EvoCardTemplate">
            <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14,12" Margin="0,0,0,8"
                    BorderThickness="1" BorderBrush="{Binding Border}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource TileButton}" Click="DexItem_Click" Padding="0" Margin="0,0,12,0" Visibility="{Binding HeaderVisibility}">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PicTemplate}" Tag="40"/>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding HeaderVisibility}">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <Border Background="{StaticResource GoodBg}" CornerRadius="4" Padding="6,1,6,2" Margin="0,4,0,0"
                                    HorizontalAlignment="Left" Visibility="{Binding BadgeVisibility}">
                                <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Good}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="{Binding PointsTooltip}">
                            <TextBlock Text="{Binding PointsText}" Foreground="{Binding PointsBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding PriorityText}" Visibility="{Binding PriorityVisibility}" Foreground="{StaticResource Muted}"
                                       FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,10" Height="4">
                        <Border Background="{StaticResource PanelHi}" CornerRadius="2"/>
                        <Border Background="{Binding PointsBrush}" CornerRadius="2" HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{x:Static local:ProgressWidth.Instance}">
                                    <Binding Path="Progress"/>
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Conditions}" ItemTemplate="{StaticResource ChipTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,4,0,0" Visibility="{Binding HintVisibility}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Suchvorschlag -->
        <DataTemplate x:Key="SuggestionTemplate">
            <StackPanel Orientation="Horizontal">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PicTemplate}" Tag="26" Margin="0,2,10,2"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
        </DataTemplate>

        <!-- Wert der Partnerleiste: Label über Zahl, keine Box -->
        <DataTemplate x:Key="StatTemplate">
            <StackPanel Margin="0,0,8,12">
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="Medium" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- Primäre Aktion: invertiert, weiße Pille mit schwarzer Schrift -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#131217"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource Text}" CornerRadius="17" Height="34" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource NeutralInk}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Digimon-Kachel mit Name, optional Pfeil (Wege) -->
        <DataTemplate x:Key="DexTileTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Style="{StaticResource TileButton}" Click="DexItem_Click" Padding="2,4" ToolTip="{Binding Name}">
                    <StackPanel Width="88">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PicTemplate}" Tag="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="WrapWithOverflow" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" MaxHeight="30"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="→" Foreground="{StaticResource Muted}" FontSize="15" VerticalAlignment="Top" Margin="0,18,0,0"
                           Visibility="{Binding ArrowVisibility}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Zeile in der Digidex-Liste: Bild, Name + Stufe, Bedingungen; Zeilen durch eine Linie getrennt -->
        <DataTemplate x:Key="DexRowTemplate">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Button Style="{StaticResource TileButton}" Click="DexItem_Click" Padding="6,8" Margin="0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PicTemplate}" Tag="40" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Stage}" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,1,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Border>
        </DataTemplate>

        <!-- Stufenfilter: dieselbe Auswahl-Linie wie die Reiter -->
        <Style x:Key="FilterToggle" TargetType="RadioButton" BasedOn="{StaticResource TabToggle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="8,8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ein Partner: Karte, nächste Digitationen, eigenes Ziel-Digimon -->
        <DataTemplate x:Key="PartnerPanelTemplate">
            <StackPanel Margin="{Binding ColumnMargin}">
                <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="16,14,16,4" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource TileButton}" Click="DexItem_Click" DataContext="{Binding Avatar}" Padding="0" Margin="0,0,14,0">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PicTemplate}" Tag="64"/>
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Finding}" Foreground="{Binding FindingBrush}" FontSize="13" FontWeight="Medium"
                                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding FindingVisibility}"/>
                                <TextBlock Text="{Binding Timing}" Foreground="{StaticResource NeutralInk}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding TimingVisibility}"
                                           ToolTip="Richtwerte aus der Community – das Spiel prüft die Digitation beim Tageswechsel."/>
                                <TextBlock Text="{Binding Plan}" Foreground="{StaticResource NeutralInk}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding PlanVisibility}"/>
                                <TextBlock Text="{Binding Warning}" Foreground="{StaticResource Bad}" FontSize="12" FontWeight="Medium"
                                           TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding WarningVisibility}"/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Stats}" Margin="0,16,0,0" ItemTemplate="{StaticResource StatTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding NextTitle}"/>
                <TextBlock Text="{Binding EmptyText}" Visibility="{Binding EmptyVisibility}" Foreground="{StaticResource Muted}"
                           FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource EvoCardTemplate}"/>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding PlanTitle}"/>
                <Grid Margin="0,0,0,8">
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="PartnerGoal_TextChanged" PreviewKeyDown="PartnerGoal_PreviewKeyDown"/>
                    <TextBlock Text="{Binding SearchPlaceholder}" Visibility="{Binding PlaceholderVisibility}" Foreground="{StaticResource Muted}"
                               FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <ListBox ItemsSource="{Binding Suggestions}" Visibility="{Binding SuggestionsVisibility}" MaxHeight="230"
                         Background="{StaticResource PanelHi}" BorderThickness="0" Margin="0,0,0,8" Padding="4"
                         ItemTemplate="{StaticResource SuggestionTemplate}"
                         MouseUp="PartnerGoalSuggestion_MouseUp" KeyDown="PartnerGoalSuggestion_KeyDown"/>
                <ItemsControl ItemsSource="{Binding GoalPath}" ItemTemplate="{StaticResource DexTileTemplate}" Margin="0,4,0,4">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{Binding GoalInfo}" Visibility="{Binding GoalInfoVisibility}" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding GoalSteps}" ItemTemplate="{StaticResource EvoCardTemplate}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource Bg}" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titelleiste -->
            <Grid Grid.Row="0" Margin="16,10,8,6" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="icon.ico" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleText" Text="DWNO Evo-Helfer" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource Muted}" Margin="14,1,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClickThroughHint" FontSize="12" Foreground="{StaticResource Accent}" Margin="12,0,0,0"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Button x:Name="UpdateButton" Style="{StaticResource LinkButton}" Foreground="{StaticResource Accent}" Margin="6,0,0,0"
                            Visibility="Collapsed" Click="Update_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpacityButton" Style="{StaticResource ChromeButton}" Width="44" FontFamily="{StaticResource UiFont}" FontSize="12" Content="100%" Click="Opacity_Click"/>
                    <Button x:Name="PinButton" Style="{StaticResource ChromeButton}" Content="&#xE718;" Click="Pin_Click"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource ChromeButton}" Content="&#xE713;" Click="Settings_Click"/>
                    <Button x:Name="MinButton" Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Moduswahl -->
            <Border x:Name="ModeBar" Grid.Row="1" Margin="16,0,16,0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModePartner" GroupName="mode" Style="{StaticResource TabToggle}" IsChecked="True" Checked="Mode_Checked">
                    <TextBlock x:Name="ModePartnerText" FontSize="14"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </RadioButton>
                <RadioButton x:Name="ModeDex" GroupName="mode" Style="{StaticResource TabToggle}" Checked="Mode_Checked">
                    <TextBlock x:Name="ModeDexText" FontSize="14"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </RadioButton>
                <RadioButton x:Name="ModeLog" GroupName="mode" Style="{StaticResource TabToggle}" Checked="Mode_Checked">
                    <TextBlock x:Name="ModeLogText" FontSize="14"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </RadioButton>
            </StackPanel>
            </Border>

            <!-- Digidex / Planen -->
            <DockPanel x:Name="DexArea" Grid.Row="2" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="16,12,16,0">
                    <Grid Margin="0,0,0,6">
                        <TextBox x:Name="DexSearch" TextChanged="DexSearch_TextChanged"/>
                        <TextBlock x:Name="DexPlaceholder" Foreground="{StaticResource Muted}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,4,0,0"><WrapPanel x:Name="DexStages"/></Border>
                </StackPanel>
            <ScrollViewer x:Name="DexView" VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
                <StackPanel>
                    <Border x:Name="DexDetail" Background="{StaticResource Panel}" CornerRadius="6" Padding="16,10,16,14" Margin="0,12,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Button x:Name="DexBack" Style="{StaticResource LinkButton}" Click="DexBack_Click" HorizontalAlignment="Left"/>
                                <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Click="DexClose_Click" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl x:Name="DexPic" ContentTemplate="{StaticResource PicTemplate}" Tag="72" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="DexName" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DexStage" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="DexCompare" IsChecked="True" Margin="0,14,0,0" Checked="DexCompare_Changed" Unchecked="DexCompare_Changed"/>

                            <TextBlock x:Name="DexReqTitle" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl x:Name="DexReq" ItemTemplate="{StaticResource EvoCardTemplate}"/>

                            <TextBlock x:Name="DexFromTitle" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="DexFromEmpty" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="DexFrom" ItemTemplate="{StaticResource DexTileTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock x:Name="DexToTitle" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="DexToEmpty" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="DexTo" ItemTemplate="{StaticResource DexTileTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock x:Name="DexPathTitle" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="DexPathInfo" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="DexPath" ItemTemplate="{StaticResource DexTileTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="DexCount" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="DexList" ItemTemplate="{StaticResource DexRowTemplate}"/>
                </StackPanel>
            </ScrollViewer>
            </DockPanel>

            <!-- Digitations-Protokoll -->
            <ScrollViewer x:Name="LogArea" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,0,16,16" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="16,14" Margin="0,12,0,0"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="LogTitle" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LogSummary" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,10"/>
                            <ItemsControl x:Name="LogScores">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="13" TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="LogReportButton" Style="{StaticResource LinkButton}" Click="OpenReport_Click" HorizontalAlignment="Left" Margin="-8,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="LogEmpty" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    <ItemsControl x:Name="LogList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14,12" Margin="0,8,0,0"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource TileButton}" Click="DexItem_Click" Padding="0" Margin="0,0,12,0">
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PicTemplate}" Tag="40"/>
                                            </Button>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontWeight="{Binding Weight}" FontSize="13" Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Verdicts}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12" Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Einrichtung -->
            <ScrollViewer x:Name="SetupView" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,0,16,16" Visibility="Collapsed">
                <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="18,16" Margin="0,12,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="SetupTitle" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SetupIntro" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" FontSize="13" LineHeight="20"/>
                        <ItemsControl x:Name="SetupChecks" ItemTemplate="{StaticResource ChipTemplate}"/>
                        <TextBlock x:Name="SetupPath" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,16"/>
                        <WrapPanel>
                            <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Click="Install_Click" Margin="0,0,8,6"/>
                            <Button x:Name="PickButton" Style="{StaticResource LinkButton}" Click="Pick_Click"/>
                            <Button x:Name="RemoveButton" Style="{StaticResource LinkButton}" Click="Remove_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="SetupMessage" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="13"/>
                        <TextBlock x:Name="HotkeyInfo" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12" Foreground="{StaticResource Muted}" LineHeight="18"/>
                        <Button x:Name="SetupCloseButton" Style="{StaticResource LinkButton}" Click="SetupClose_Click" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Hauptansicht: feste Partnerauswahl + scrollbarer Inhalt -->
            <DockPanel x:Name="MainArea" Grid.Row="2">
                <Border DockPanel.Dock="Top" Margin="16,8,16,12" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <StackPanel x:Name="PartnerBar" Orientation="Horizontal">
                    <RadioButton x:Name="Tab0" GroupName="partner" Style="{StaticResource TabToggle}" IsChecked="True" Checked="Tab_Checked" Tag="0">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl x:Name="Tab0Pic" ContentTemplate="{StaticResource PicTemplate}" Tag="20" Margin="0,0,8,0"/>
                            <TextBlock x:Name="Tab0Text" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Tab1" GroupName="partner" Style="{StaticResource TabToggle}" Checked="Tab_Checked" Tag="1">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl x:Name="Tab1Pic" ContentTemplate="{StaticResource PicTemplate}" Tag="20" Margin="0,0,8,0"/>
                            <TextBlock x:Name="Tab1Text" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabBoth" GroupName="partner" Style="{StaticResource TabToggle}" Checked="Tab_Checked" Tag="2">
                        <TextBlock x:Name="TabBothText" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                </StackPanel>
                </Border>
                <ScrollViewer x:Name="MainView" VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
                    <ItemsControl x:Name="PartnerPanels" ItemTemplate="{StaticResource PartnerPanelTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <TextBlock x:Name="Footer" Grid.Row="3" Margin="16,6,16,12" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
