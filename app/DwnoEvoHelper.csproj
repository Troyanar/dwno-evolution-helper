<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 is preinstalled on every Windows 10/11 → a single EXE with no extra installation -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DWNO-Evolution-Helper</AssemblyName>
    <Product>Digimon World Next Order Evolution Helper</Product>
    <AssemblyTitle>Digimon World Next Order Evolution Helper</AssemblyTitle>
    <RootNamespace>DwnoEvoHelper</RootNamespace>
    <Version>1.7.0</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Resource Include="icon.ico" />
    <Resource Include="Fonts\*.ttf" />
    <!-- The game plugin is embedded in the EXE and copied into the game folder during setup -->
    <EmbeddedResource Include="..\plugin\bin\out\DWNO_EvolutionHelper.dll" LogicalName="DWNO_EvolutionHelper.dll" />
    <!-- Digimon images (128 px) and Digimon table for Digidex/planning without starting the game -->
    <EmbeddedResource Include="Resources\icons.zip" LogicalName="icons.zip" />
    <EmbeddedResource Include="Resources\gamedata.json" LogicalName="gamedata.json" />
  </ItemGroup>

</Project>
